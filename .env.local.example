# Salin file ini jadi .env.local lalu isi dengan nilai dari project Supabase kamu
# (Supabase Dashboard > Project Settings > API)

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=isi-dengan-anon-public-key-kamu

# Dibutuhkan untuk fitur Scan Struk dengan AI (pakai Google Gemini, gratis).
# Buat API key gratis di https://aistudio.google.com/apikey
# JANGAN tambahkan NEXT_PUBLIC_ di depan variable ini — ini harus tetap
# rahasia di server, tidak boleh terlihat di browser.
GEMINI_API_KEY=isi-dengan-gemini-api-key-kamu
